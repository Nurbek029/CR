<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок и кнопка закрытия -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Детали игрока"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true" />

            <ImageView
                android:id="@+id/closeButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Закрыть"
                android:padding="5dp" />

        </RelativeLayout>

        <!-- Фото игрока (большое) -->
        <ImageView
            android:id="@+id/dialogPlayerCutout"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Player photo"
            android:src="@drawable/ic_person"
            android:layout_marginBottom="16dp" />

        <!-- Основная информация -->
        <TextView
            android:id="@+id/dialogPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="Player Name"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Маленькое фото -->
            <ImageView
                android:id="@+id/dialogPlayerPhoto"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:scaleType="centerCrop"
                android:contentDescription="Player thumbnail"
                android:src="@drawable/ic_person" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogPlayerPosition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:text="Position"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/dialogPlayerNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:text="Number"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/dialogPlayerNationality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="Nationality" />
            </LinearLayout>
        </LinearLayout>

        <!-- Детальная информация -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Детальная информация"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/dialogPlayerBirthDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дата рождения: "
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/dialogPlayerHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Рост: "
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/dialogPlayerWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вес: "
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Описание -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/dialogPlayerDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Player description"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>