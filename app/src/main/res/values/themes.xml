<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема приложения -->
    <style name="Theme.KP" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- ★ ОСНОВНЫЕ ЦВЕТА Material Components ★ -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- ★ ВТОРИЧНЫЕ ЦВЕТА Material Components ★ -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- ★ ФОНОВЫЕ ЦВЕТА ★ -->
        <item name="android:colorBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>

        <!-- ★ ЦВЕТА ТЕКСТА ★ -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/teal_700</item>

        <!-- ★ СТАТУС БАР ★ -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- ★ СТИЛИ ДЛЯ ВИДЖЕТОВ ★ -->
        <item name="bottomNavigationStyle">@style/Widget.MaterialComponents.BottomNavigationView.Colored</item>
        <item name="buttonStyle">@style/Widget.MaterialComponents.Button</item>
        <item name="cardViewStyle">@style/Widget.MaterialComponents.CardView</item>

        <!-- ★ НАСТРОЙКИ ВНЕШНЕГО ВИДА ★ -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>