<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ★ ОСНОВНАЯ ТЕМА ПРИЛОЖЕНИЯ ★ -->
    <style name="Theme.KP" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- ★ ОСНОВНЫЕ ЦВЕТА ★ -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_primary_light</item>

        <!-- ★ ВТОРИЧНЫЕ ЦВЕТА ★ -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_primary_light</item>

        <!-- ★ ФОНОВЫЕ ЦВЕТА ★ -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_white</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <!-- ★ ЦВЕТА ТЕКСТА ★ -->
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>

        <!-- ★ СТАТУС БАР И НАВИГАЦИЯ ★ -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- ★ СТИЛИ ВИДЖЕТОВ ★ -->
        <item name="bottomNavigationStyle">@style/Widget.KP.BottomNavigationView</item>
        <item name="buttonStyle">@style/Widget.KP.Button</item>
        <item name="cardViewStyle">@style/Widget.KP.CardView</item>
        <item name="materialButtonStyle">@style/Widget.KP.Button</item>

        <!-- ★ НАСТРОЙКИ ВНЕШНЕГО ВИДА ★ -->
        <item name="android:windowBackground">@drawable/gradient_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- ★ ТИПОГРАФИЯ ★ -->
        <item name="fontFamily">sans-serif</item>
        <item name="android:textAppearance">@style/TextAppearance.KP.Body1</item>

        <!-- ★ ФОРМЫ ★ -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.KP.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KP.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.KP.Large</item>
    </style>

    <!-- ★ ФОРМЫ С СКРУГЛЕННЫМИ УГЛАМИ ★ -->
    <style name="ShapeAppearance.KP.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.KP.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.KP.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ★ ТИПОГРАФИЯ ★ -->
    <style name="TextAppearance.KP.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.KP.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.KP.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.KP.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ★ СТИЛЬ КНОПОК ★ -->
    <style name="Widget.KP.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">@drawable/button_gradient</item>
    </style>

    <!-- ★ СТИЛЬ КАРТОЧЕК ★ -->
    <style name="Widget.KP.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- ★ СТИЛЬ НИЖНЕГО МЕНЮ ★ -->
    <style name="Widget.KP.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/bottom_nav_background</item>
        <item name="itemIconTint">@drawable/bottom_nav_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_selector</item>
        <item name="itemRippleColor">@color/accent_light</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <!-- ★ СТИЛЬ SEARCH VIEW ★ -->
    <style name="Widget.KP.SearchView" parent="Widget.AppCompat.SearchView">
        <item name="searchHintIcon">@android:drawable/ic_menu_search</item>
        <item name="closeIcon">@android:drawable/ic_menu_close_clear_cancel</item>
        <item name="android:background">@drawable/search_view_background</item>
        <item name="queryBackground">@drawable/search_view_query_background</item>
    </style>

    <!-- ★ ДИАЛОГОВЫЙ СТИЛЬ ★ -->
    <style name="Theme.KP.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>